{
  "name": "math-tug-of-war",
  "version": "0.1.0",
  "description": "A polished 2D arcade browser game where two players compete by answering math questions to pull a rope past the opponent's boundary.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["game", "phaser", "arcade", "math", "education", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "phaser": "^3.86.0"
  }
}
